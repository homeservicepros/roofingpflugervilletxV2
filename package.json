    "verify:parity": "python3 -I scripts/verify-parity.py",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
