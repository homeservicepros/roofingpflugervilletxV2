{
  "name": "pflugerville-roof-experts",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Pflugerville Roof Experts \u2014 Astro static site for Cloudflare Pages",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "extract": "python3 -I scripts/extract-legacy.py",
    "brand-assets": "node scripts/make-brand-assets.mjs",
