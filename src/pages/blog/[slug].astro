---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import NationwideStates from '../../components/NationwideStates.astro';
import FinalCta from '../../components/FinalCta.astro';
import { posts, type Post } from '../../data/blog';
import shared from '../../data/legacy/shared.json';
import { site, abs } from '../../config/site';
import { stripEmoji, truncate } from '../../lib/text';
import { graph, businessNode, websiteNode, webPageNode, breadcrumbNode, ids } from '../../lib/schema';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Post };
const shareImg = await getImage({ src: p.image, width: 1200, height: 630, format: 'jpg', quality: 82 });
const og = abs(shareImg.src);
const others = posts.filter((x) => x.slug !== p.slug).slice(0, 3);

const schema = graph(
  businessNode(),
  websiteNode(),
  webPageNode({ path: p.path, name: p.title, description: p.description, type: 'WebPage', image: og, breadcrumb: true }),
  breadcrumbNode(p.path, [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: p.h1, path: p.path }]),
  {
    '@type': 'BlogPosting',
    '@id': `${abs(p.path)}#article`,
    headline: truncate(p.h1, 110),
    name: p.h1,
    description: p.description,
    url: abs(p.path),
    mainEntityOfPage: { '@id': `${abs(p.path)}#webpage` },
    datePublished: p.isoDate,
    dateModified: p.isoDate,
    image: og,
    inLanguage: 'en-US',
    author: { '@id': ids.business },
    publisher: { '@id': ids.business },
    isPartOf: { '@type': 'Blog', '@id': `${abs('/blog/')}#blog`, name: 'Pflugerville Roof Experts Blog' },
  },
);
---
<BaseLayout title={p.title} description={p.description} path={p.path} image={og} ogType="article" publishedTime={p.isoDate} schema={schema} footerTagline={shared.footerTaglineBlog}>
  <PageHero h1={p.h1} crumbs={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: truncate(p.h1, 48) }]} eyebrow="Blog" eyebrowIcon="newspaper" ctaLabel={`Call ${site.phone.display}`}
    image={p.image} imageAlt="Pflugerville roofing project" meta={[]} />

  <section class="section bg-white">
    <div class="wrap">
      <div class="mx-auto max-w-3xl">
        <p class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.95rem] font-semibold text-ink-500">
          <span class="inline-flex items-center gap-2"><Icon name="user-round" class="size-5 text-brand-600" />{p.author}</span>
          <span class="inline-flex items-center gap-2"><Icon name="calendar-days" class="size-5 text-brand-600" /><time datetime={p.isoDate}>{p.date}</time></span>
        </p>
        <blockquote class="mt-6 rounded-r-2xl border-l-[6px] border-brand-600 bg-brand-50 px-6 py-5 text-lg italic leading-relaxed text-ink-700">{p.lead}</blockquote>
        <article class="prose-roof mt-10" set:html={p.prose} />

        <div class="mt-12 overflow-hidden rounded-2xl bg-ink-900 p-7 text-white shadow-lift sm:p-9">
          <h2 class="font-display text-3xl font-bold uppercase leading-none sm:text-4xl">{p.cta.title}</h2>
          <p class="mt-3 text-ink-200">{p.cta.text}</p>
          <a href={site.phone.href} class="btn btn-primary mt-6"><Icon name="phone" class="size-5" />{stripEmoji(p.cta.button)}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-ink-50" aria-labelledby="more-h">
    <div class="wrap">
      <h2 id="more-h" class="section-title !text-4xl">More from the blog</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {others.map((o) => (
          <li>
            <a href={o.path} class="card group flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
              <Photo src={o.image} alt="" class="aspect-[16/10] w-full object-cover" widths={[480, 768]} sizes="(min-width: 768px) 380px, 100vw" />
              <span class="flex flex-1 flex-col p-5">
                <span class="text-sm font-semibold text-ink-500">{o.date}</span>
                <span class="mt-2 text-lg font-bold leading-snug text-ink-900 group-hover:text-brand-700">{o.indexTitle}</span>
                <span class="mt-4 inline-flex items-center gap-2 font-bold text-brand-700">{o.readMore}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NationwideStates />
  <FinalCta title={p.cta.title} text={p.cta.text} button={stripEmoji(p.cta.button)} />
</BaseLayout>
