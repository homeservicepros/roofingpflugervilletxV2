---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import FaqList from '../../components/FaqList.astro';
import MapSection from '../../components/MapSection.astro';
import NationwideStates from '../../components/NationwideStates.astro';
import FinalCta from '../../components/FinalCta.astro';
import { Image } from 'astro:assets';
import { services, type Service } from '../../data/services';
import { areas } from '../../data/areas';
import { site, abs } from '../../config/site';
import { img } from '../../lib/images';
import { stripEmoji } from '../../lib/text';
import { graph, businessNode, websiteNode, webPageNode, breadcrumbNode, faqNode, ids } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const shareImg = await getImage({ src: s.image, width: 1200, height: 630, format: 'jpg', quality: 82 });
const og = abs(shareImg.src);

const related = services.filter((x) => x.category === s.category && x.slug !== s.slug).slice(0, 5);
const featuredAreas = s.areasCard.links;
const moreAreas = areas.filter((a) => !featuredAreas.some((l) => l.href === a.path));

const crumbs = [{ name: 'Home', path: '/' }, { name: s.name }];
const schema = graph(
  businessNode(),
  websiteNode(),
  webPageNode({ path: s.path, name: s.title, description: s.description, image: og, breadcrumb: true }),
  breadcrumbNode(s.path, [{ name: 'Home', path: '/' }, { name: s.name, path: s.path }]),
  {
    '@type': 'Service',
    '@id': `${abs(s.path)}#service`,
    name: s.name,
    serviceType: s.name,
    description: s.description,
    url: abs(s.path),
    image: og,
    provider: { '@id': ids.business },
    areaServed: { '@type': 'City', name: 'Pflugerville', containedInPlace: { '@type': 'State', name: 'Texas' } },
  },
  faqNode(s.path, s.faq),
);
---
<BaseLayout title={s.title} description={s.description} path={s.path} image={og} schema={schema}>
  <PageHero
    h1={s.h1} subtitle={s.subtitle} image={s.image} imageAlt={s.imageAlt} crumbs={crumbs}
    eyebrow={`${s.category} · Pflugerville, TX`} eyebrowIcon={s.icon}
    ctaLabel={`Call ${site.phone.display} Now`} meta={['Licensed & Insured', '24/7 Emergency']}
  />

  <section class="section bg-white">
    <div class="wrap grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_21.5rem] xl:gap-14">
      <div class="min-w-0 space-y-14">
        <article class="card p-6 sm:p-10 reveal">
          <div class="prose-roof" set:html={s.prose} />
        </article>

        <section aria-labelledby="benefits-h">
          <h2 id="benefits-h" class="h-display border-l-[5px] border-brand-600 pl-4 text-[1.9rem] text-ink-900 sm:text-[2.2rem]">{s.benefitsHeading}</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {s.benefits.map((b) => (
              <li class:list={['card flex gap-4 p-5 reveal', b.text ? 'items-start' : 'items-center']}>
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-600 text-white shadow-brand"><Icon name="check" class="size-5" stroke={3} /></span>
                <div><h3 class="text-[1.05rem] font-bold leading-snug text-ink-900">{b.title}</h3>{b.text && <p class="mt-1 text-ink-500">{b.text}</p>}</div>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="process-h">
          <h2 id="process-h" class="h-display border-l-[5px] border-brand-600 pl-4 text-[1.9rem] text-ink-900 sm:text-[2.2rem]">{s.processHeading}</h2>
          <ol class="relative mt-8 space-y-5 before:absolute before:bottom-6 before:left-[1.4rem] before:top-6 before:w-0.5 before:bg-gradient-to-b before:from-brand-600 before:to-brand-200">
            {s.process.map((p, i) => (
              <li class="relative flex items-center gap-5 reveal">
                <span class="relative z-10 grid size-12 shrink-0 place-items-center rounded-full bg-ink-900 font-display text-2xl font-bold text-white ring-4 ring-white">{i + 1}</span>
                <div class="card flex-1 px-5 py-4">
                  <h3 class="text-[1.05rem] font-bold text-ink-900">{p.title}</h3>
                  {p.text && <p class="mt-1 text-ink-500">{p.text}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28" aria-label="Contact and related links">
        <div class="relative overflow-hidden rounded-2xl bg-ink-900 p-7 text-white shadow-lift">
          <div class="absolute -right-12 -top-12 size-44 rounded-full bg-brand-600/40 blur-2xl"></div>
          <Image src={img.badgeRound} alt="Pflugerville Roof Experts 24/7 service badge" width={96} height={96} class="absolute right-4 top-4 size-20 rounded-full opacity-95" format="webp" quality={85} loading="lazy" />
          <h2 class="relative max-w-[10rem] font-display text-3xl font-bold uppercase leading-none">{s.cta.title}</h2>
          <p class="relative mt-4 text-[0.97rem] leading-relaxed text-ink-200">{s.cta.text}</p>
          <a href={site.phone.href} class="btn btn-primary relative mt-6 w-full"><Icon name="phone" class="size-5" />Call {site.phone.display}</a>
        </div>

        <div class="card p-6">
          <h2 class="flex items-center gap-2 font-display text-2xl font-bold uppercase leading-none text-ink-900"><Icon name="map-pin" class="size-5 text-brand-600" />{s.areasCard.title}</h2>
          <p class="mt-3 text-sm text-ink-500">{s.areasCard.text}</p>
          <ul class="mt-3 space-y-0.5">
            {featuredAreas.map((a) => (<li><a href={a.href} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[0.93rem] font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"><Icon name="map-pin" class="size-4 text-ink-400" />{a.label}</a></li>))}
          </ul>
          <details class="group mt-2">
            <summary class="flex cursor-pointer list-none items-center gap-1 px-2 py-1.5 text-sm font-bold text-brand-700 [&::-webkit-details-marker]:hidden">All neighborhoods <Icon name="chevron-down" class="size-4 transition-transform group-open:rotate-180" /></summary>
            <ul class="space-y-0.5">
              {moreAreas.map((a) => (<li><a href={a.path} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[0.93rem] font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"><Icon name="map-pin" class="size-4 text-ink-400" />{a.name}</a></li>))}
            </ul>
          </details>
        </div>

        <div class="card p-6">
          <h2 class="flex items-center gap-2 font-display text-2xl font-bold uppercase leading-none text-ink-900"><Icon name="wrench" class="size-5 text-brand-600" />Related Services</h2>
          <ul class="mt-3 space-y-0.5">
            {related.map((r) => (<li><a href={r.path} title={r.name} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[0.93rem] font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"><Icon name={r.icon} class="size-4 text-ink-400" />{r.name}</a></li>))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <FaqList heading={s.faqHeading} items={s.faq} closing={s.faqClosing} />

  <MapSection title={s.map.title} subtitle={s.map.subtitle} iframe={s.map.iframe} contact={s.map.contact} mapTitle={`Map of ${s.name} service area`} tone="white" />

  <NationwideStates />
  <FinalCta title={s.cta.title} text={s.cta.text} />
</BaseLayout>
