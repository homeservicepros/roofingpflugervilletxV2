---
import { iconMarkup } from '../lib/icons';
interface Props { name: string; class?: string; stroke?: number; label?: string }
const { name, class: cls = 'size-5', stroke = 2, label } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
  class:list={['shrink-0', cls]} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}
  set:html={iconMarkup(name)}
/>
