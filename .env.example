# Copy to .env for local work. On Cloudflare Pages add the same names under
# Settings → Variables and Secrets (Production and Preview), then redeploy.

# Google Analytics 4 measurement ID (e.g. G-ABC123XYZ). Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty if unused.
PUBLIC_GTM_ID=

# Optional: override the canonical site URL (defaults to https://www.pflugervilleroofexperts.com)
# PUBLIC_SITE_URL=
